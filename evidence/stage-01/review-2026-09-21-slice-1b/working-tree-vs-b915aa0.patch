+
+def complete(proposal_id: str, actor: str, order: int, *, action_id: str) -> Proposal:
+    """Commit the owner's previously reserved plan exactly once."""
+    return Proposal(proposal_id, actor, order, OP_COMPLETE, {"action_id": action_id})
